apiVersion: v1
kind: Pod
metadata:
  name: numa-test
spec:
  runtimeClassName: {{ gpu_runtime_class }}
  containers:
  - name: numa-check
    image: ubuntu:24.04
    command: ["sleep", "infinity"]
    resources:
      requests:
        cpu: "1"
        memory: "1Gi"
      limits:
        cpu: "{{ pod_cpu_limit }}"
        memory: "{{ pod_memory_limit }}"
