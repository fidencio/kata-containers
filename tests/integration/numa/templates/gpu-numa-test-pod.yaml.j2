apiVersion: v1
kind: Pod
metadata:
  name: gpu-numa-test
spec:
  runtimeClassName: {{ gpu_runtime_class }}
  containers:
  - name: cuda-test
    image: nvcr.io/nvidia/k8s/cuda-sample:vectoradd-cuda12.5.0-ubuntu22.04
    command: ["sleep", "infinity"]
    resources:
      limits:
        cpu: "{{ gpu_pod_cpu_limit }}"
        memory: "{{ gpu_pod_memory_limit }}"
        nvidia.com/pgpu: "1"
