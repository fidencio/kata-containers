# Helm values for kata-deploy with NUMA drop-in
# Generated by the NUMA verification playbook

image:
  reference: "{{ kata_deploy_image }}"
  tag: "{{ kata_deploy_tag }}"

shims:
  disableAll: false

customRuntimes:
  enabled: true
  runtimes:
    numa:
      baseConfig: qemu
      runtimeClass: |
        apiVersion: node.k8s.io/v1
        kind: RuntimeClass
        metadata:
          name: {{ numa_runtime_class }}
        handler: {{ numa_runtime_class }}
      dropIn: |
        [hypervisor.qemu]
        enable_numa = true
        numa_mapping = []

        [runtime]
        static_sandbox_resource_mgmt = true
        enable_vcpus_pinning = true
